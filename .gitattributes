# Default text handling
* text=auto

# PowerShell
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf

# Documentation
*.md text eol=crlf
*.txt text eol=crlf

# Configuration
*.json text eol=lf
*.xml text eol=crlf
*.yml text eol=lf
*.yaml text eol=lf

# Binary files
*.exe binary
*.dll binary
*.wim binary
*.esd binary
*.iso binary
*.7z binary
*.zip binary
